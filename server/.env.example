# 复制为 .env 后填写。不填 DEEPSEEK_API_KEY 时自动使用离线模拟（不花钱）。
DEEPSEEK_API_KEY=
# AI_PROVIDER=deepseek   # deepseek | mock
# DEEPSEEK_MODEL=deepseek-chat

PORT=8787
HOST=127.0.0.1

# 费用控制
MAX_CONCURRENT_GAMES=2
GAMES_PER_IP_PER_HOUR=3
GAMES_PER_DAY=50

# 部署在 nginx 后面时设为 1，按真实用户 IP 限流
TRUST_PROXY=0

# 观看节奏：每条发言后按字数停顿（毫秒/字），0 为全速（夜间节拍一并取消，除非单独设置）
READING_MS_PER_CHAR=45
# 夜间每一步之间的停顿（毫秒）：天黑请闭眼、狼刀、预言家、女巫、天亮、猎人。0 为不等待。
NIGHT_BEAT_MS=7000
